# Copy to .env and fill in an API key. Never commit .env.

POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot

CORS_ALLOWED_ORIGIN=http://localhost:3001

# Primary LLM: any OpenAI-compatible endpoint (default: Gemini free tier).
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=

# Fallback LLM (default: Groq). Used on 429/5xx before the first token.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Header X-Admin-Key for /api/admin/*. Demo-grade protection only.
ADMIN_KEY=
